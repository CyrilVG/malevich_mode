+  #define USARTx UART5
+  #define USARTx_IRQn UART5_IRQn
 #elif CONFIG_STM32_SERIAL_USART6
   DECL_CONSTANT_STR("RESERVE_PINS_serial", "PA12,PA11");
   #define GPIO_Rx GPIO('A', 12)
